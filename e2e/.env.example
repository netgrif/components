# Copy to e2e/.env (gitignored) for local runs. In a pipeline set these as secret environment variables instead.
# The admin of the engine (application-engine: SuperCreator, nae.admin.password of the active profile).
E2E_USERNAME=super@netgrif.com
E2E_PASSWORD=
# second user without process roles, John Doe: registered by frontend/register.setup.ts through Mailpit (any address and password)
# (application-engine: docker compose --profile e2e up -d mailpit; optional E2E_MAILPIT_URL, E2E_ENGINE_URL)
E2E_USER2_USERNAME=john.doe@netgrif.com
E2E_USER2_PASSWORD=
# optional
# E2E_FRONTEND_URL=http://localhost:4200
