	<data type="enumeration_map">
		<id>fork</id>
		<title>Fork</title>
		<options>
			<option key="var_auto">Auto trigger</option>
			<option key="var_time">Time trigger</option>
			<option key="var_other">Other</option>
		</options>
		<event type="set">
			<id>set_event_0</id>
			<actions phase="post">
				<action id="action_0">fork: f.fork,
                var_auto: f.var_auto,
                var_time: f.var_time,
                var_other: f.var_other;
            
                if (fork.value == "var_auto") {
                    change var_auto value { 1 }
                    change var_time value { 0 }
                    change var_other value { 0 }
                } else if (fork.value == "var_time") {
                    change var_auto value { 0 }
                    change var_time value { 1 }
                    change var_other value { 0 }
                } else {
                    change var_auto value { 0 }
                    change var_time value { 0 }
                    change var_other value { 1 }
                }</action>
			</actions>
		</event>
	</data>
