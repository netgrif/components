<?xml version="1.0" encoding="UTF-8"?>
<!-- e2e: a process without the default role, only the role Creator may create its cases (NAE-TC-020) -->
<document xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://petriflow.com/petriflow.schema.xsd">
    <id>e2e_no_create</id>
    <initials>ENC</initials>
    <title>E2E no create</title>
    <defaultRole>false</defaultRole>
    <anonymousRole>false</anonymousRole>
    <role>
        <id>creator</id>
        <title>Creator</title>
    </role>
    <roleRef>
        <id>creator</id>
        <caseLogic>
            <create>true</create>
            <delete>true</delete>
            <view>true</view>
        </caseLogic>
    </roleRef>
    <transition>
        <id>t1</id>
        <x>300</x>
        <y>100</y>
        <label>Task</label>
        <roleRef>
            <id>creator</id>
            <logic>
                <perform>true</perform>
                <view>true</view>
            </logic>
        </roleRef>
    </transition>
    <place>
        <id>p1</id>
        <x>100</x>
        <y>100</y>
        <tokens>1</tokens>
        <static>false</static>
    </place>
    <arc>
        <id>a1</id>
        <type>regular</type>
        <sourceId>p1</sourceId>
        <destinationId>t1</destinationId>
        <multiplicity>1</multiplicity>
    </arc>
</document>
