<?xml version="1.0" encoding="UTF-8"?>
<!-- e2e: the case permissions of the process roles (case-permissions.spec): Creator creates and views the cases,
     Viewer only views them, Manager views and deletes them; a user without a role does not see the cases.
     A permission set to false denies it even when another role of the user allows it, so the roles define only the
     allowed permissions -->
<document xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://petriflow.com/petriflow.schema.xsd">
    <id>e2e_case_permissions</id>
    <initials>ECP</initials>
    <title>E2E case permissions</title>
    <defaultRole>false</defaultRole>
    <anonymousRole>false</anonymousRole>
    <role>
        <id>creator</id>
        <title>Creator</title>
    </role>
    <role>
        <id>viewer</id>
        <title>Viewer</title>
    </role>
    <role>
        <id>manager</id>
        <title>Manager</title>
    </role>
    <roleRef>
        <id>creator</id>
        <caseLogic>
            <create>true</create>
            <view>true</view>
        </caseLogic>
    </roleRef>
    <roleRef>
        <id>viewer</id>
        <caseLogic>
            <view>true</view>
        </caseLogic>
    </roleRef>
    <roleRef>
        <id>manager</id>
        <caseLogic>
            <delete>true</delete>
            <view>true</view>
        </caseLogic>
    </roleRef>
    <transition>
        <id>t1</id>
        <x>300</x>
        <y>100</y>
        <label>Task</label>
        <roleRef>
            <id>creator</id>
            <logic>
                <perform>true</perform>
                <view>true</view>
            </logic>
        </roleRef>
    </transition>
    <place>
        <id>p1</id>
        <x>100</x>
        <y>100</y>
        <tokens>1</tokens>
        <static>false</static>
    </place>
    <arc>
        <id>a1</id>
        <type>regular</type>
        <sourceId>p1</sourceId>
        <destinationId>t1</destinationId>
        <multiplicity>1</multiplicity>
    </arc>
</document>
