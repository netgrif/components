			<id>t3_finish</id>
			<actions phase="pre">
				<action id="action3">
					<![CDATA[
					text_5: f.text_5;
					def variable2 = "Request registered.";
					change text_5 value { variable2; }
					
					]]>
				</action>
			</actions>
			<actions phase="post">
				<action id="action2">
					<![CDATA[
					decision: f.decision;
					if (decision.value == true) {
						async.run{
						assignTask("t4")
						finishTask("t4")
					}
					
					}else {
						async.run{
						assignTask("t6")
						finishTask("t6")
					}
					
					}
					
					]]>
				</action>
			</actions>
		</event>
