{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "netgrif-components-core": {
            "projectType": "library",
            "root": "projects/netgrif-components-core",
            "sourceRoot": "projects/netgrif-components-core/src",
            "prefix": "nae",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "options": {
                        "tsConfig": "projects/netgrif-components-core/tsconfig.lib.json",
                        "project": "projects/netgrif-components-core/ng-package.json"
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/netgrif-components-core/tsconfig.lib.prod.json"
                        }
                    }
                },
                "test": {
                    "builder": "@angular/build:karma",
                    "options": {
                        "main": "projects/netgrif-components-core/src/test.ts",
                        "polyfills": [
                            "zone.js",
                            "zone.js/testing"
                        ],
                        "tsConfig": "projects/netgrif-components-core/tsconfig.spec.json",
                        "karmaConfig": "projects/netgrif-components-core/karma.conf.js",
                        "sourceMap": true,
                        "codeCoverage": true,
                        "codeCoverageExclude": [
                            "projects/netgrif-components-core/src/test.ts",
                            "projects/netgrif-components-core/src/commons/**"
                        ],
                        "watch": false
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "projects/netgrif-components-core/src/lib/**/*.ts",
                            "projects/netgrif-components-core/src/lib/**/*.html"
                        ]
                    }
                }
            }
        },
        "netgrif-components": {
            "projectType": "library",
            "root": "projects/netgrif-components",
            "sourceRoot": "projects/netgrif-components/src",
            "prefix": "nc",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "options": {
                        "tsConfig": "projects/netgrif-components/tsconfig.lib.json",
                        "project": "projects/netgrif-components/ng-package.json"
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/netgrif-components/tsconfig.lib.prod.json"
                        }
                    }
                },
                "test": {
                    "builder": "@angular/build:karma",
                    "options": {
                        "main": "projects/netgrif-components/src/test.ts",
                        "polyfills": [
                            "zone.js",
                            "zone.js/testing"
                        ],
                        "tsConfig": "projects/netgrif-components/tsconfig.spec.json",
                        "karmaConfig": "projects/netgrif-components/karma.conf.js",
                        "sourceMap": true,
                        "codeCoverage": true,
                        "codeCoverageExclude": [
                            "projects/netgrif-components/src/test.ts"
                        ],
                        "watch": false
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "projects/netgrif-components/**/*.ts",
                            "projects/netgrif-components/**/*.html"
                        ]
                    }
                }
            }
        },
        "netgrif-example": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "projects/netgrif-example",
            "sourceRoot": "projects/netgrif-example/src",
            "prefix": "ne",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "allowedCommonJsDependencies": [
                            "moment",
                            "buffer",
                            "easymde",
                            "semver",
                            "rfdc",
                            "escape-string-regexp",
                            "quill-delta"
                        ],
                        "outputPath": {
                            "base": "dist/netgrif-example",
                            "browser": ""
                        },
                        "index": "projects/netgrif-example/src/index.html",
                        "browser": "projects/netgrif-example/src/main.ts",
                        "polyfills": [
                            "zone.js"
                        ],
                        "tsConfig": "projects/netgrif-example/tsconfig.app.json",
                        "assets": [
                            "projects/netgrif-example/src/favicon.ico",
                            "projects/netgrif-example/src/assets",
                            {
                                "glob": "**/*",
                                "input": "node_modules/monaco-editor/min-maps",
                                "output": "assets/monaco/min-maps"
                            },
                            {
                                "glob": "**/*",
                                "input": "node_modules/monaco-editor/min",
                                "output": "assets/monaco/min"
                            },
                            {
                                "glob": "default-user-*",
                                "input": "node_modules/@netgrif/components/src/assets",
                                "output": "assets"
                            }
                        ],
                        "styles": [
                            "projects/netgrif-example/src/styles.scss"
                        ],
                        "scripts": [],
                        "extractLicenses": false,
                        "sourceMap": true,
                        "optimization": false,
                        "namedChunks": true
                    },
                    "configurations": {
                        "production": {
                            "fileReplacements": [
                                {
                                    "replace": "projects/netgrif-example/src/environments/environment.ts",
                                    "with": "projects/netgrif-example/src/environments/environment.prod.ts"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "extractLicenses": true,
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2mb",
                                    "maximumError": "6.5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "6kb",
                                    "maximumError": "10kb"
                                }
                            ]
                        }
                    },
                    "defaultConfiguration": ""
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": {
                        "buildTarget": "netgrif-example:build"
                    },
                    "configurations": {
                        "production": {
                            "buildTarget": "netgrif-example:build:production"
                        }
                    }
                },
                "extract-i18n": {
                    "builder": "@angular/build:extract-i18n",
                    "options": {
                        "buildTarget": "netgrif-example:build"
                    }
                },
                "test": {
                    "builder": "@angular/build:karma",
                    "options": {
                        "main": "projects/netgrif-example/src/test.ts",
                        "polyfills": [
                            "zone.js",
                            "zone.js/testing"
                        ],
                        "tsConfig": "projects/netgrif-example/tsconfig.spec.json",
                        "karmaConfig": "projects/netgrif-example/karma.conf.js",
                        "assets": [
                            "projects/netgrif-example/src/favicon.ico",
                            "projects/netgrif-example/src/assets",
                            {
                                "glob": "default-user-*",
                                "input": "node_modules/@netgrif/components/src/assets",
                                "output": "assets"
                            }
                        ],
                        "styles": [
                            "projects/netgrif-example/src/styles.scss"
                        ],
                        "scripts": [],
                        "watch": false
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "projects/netgrif-example/**/*.ts",
                            "projects/netgrif-example/**/*.html"
                        ]
                    }
                }
            }
        },
        "netgrif-frontend": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "projects/netgrif-frontend",
            "sourceRoot": "projects/netgrif-frontend/src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "allowedCommonJsDependencies": [
                            "moment",
                            "buffer",
                            "easymde",
                            "semver",
                            "rfdc",
                            "escape-string-regexp"
                        ],
                        "outputPath": {
                            "base": "dist/netgrif-frontend",
                            "browser": ""
                        },
                        "index": "projects/netgrif-frontend/src/index.html",
                        "browser": "projects/netgrif-frontend/src/main.ts",
                        "polyfills": [
                            "zone.js"
                        ],
                        "tsConfig": "projects/netgrif-frontend/tsconfig.app.json",
                        "assets": [
                            "projects/netgrif-frontend/src/favicon.ico",
                            "projects/netgrif-frontend/src/assets",
                            {
                                "glob": "**/*",
                                "input": "node_modules/monaco-editor/min-maps",
                                "output": "assets/monaco/min-maps"
                            },
                            {
                                "glob": "**/*",
                                "input": "node_modules/monaco-editor/min",
                                "output": "assets/monaco/min"
                            }
                        ],
                        "styles": [
                            "projects/netgrif-frontend/src/styles.scss"
                        ],
                        "scripts": []
                    },
                    "configurations": {
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "namedChunks": true
                        },
                        "production": {
                            "fileReplacements": [
                                {
                                    "replace": "projects/netgrif-frontend/src/environments/environment.ts",
                                    "with": "projects/netgrif-frontend/src/environments/environment.prod.ts"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "extractLicenses": true,
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "8mb",
                                    "maximumError": "16mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "6kb",
                                    "maximumError": "10kb"
                                }
                            ]
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": {
                        "buildTarget": "netgrif-frontend:build"
                    },
                    "configurations": {
                        "development": {
                            "buildTarget": "netgrif-frontend:build:development"
                        },
                        "production": {
                            "buildTarget": "netgrif-frontend:build:production"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "projects/netgrif-frontend/**/*.ts",
                            "projects/netgrif-frontend/**/*.html"
                        ]
                    }
                }
            }
        }
    },
    "cli": {
        "analytics": false,
        "schematicCollections": [
            "@angular-eslint/schematics"
        ]
    },
    "schematics": {
        "@schematics/angular:component": {
            "type": "component"
        },
        "@schematics/angular:directive": {
            "type": "directive"
        },
        "@schematics/angular:service": {
            "type": "service"
        },
        "@schematics/angular:guard": {
            "typeSeparator": "."
        },
        "@schematics/angular:interceptor": {
            "typeSeparator": "."
        },
        "@schematics/angular:module": {
            "typeSeparator": "."
        },
        "@schematics/angular:pipe": {
            "typeSeparator": "."
        },
        "@schematics/angular:resolver": {
            "typeSeparator": "."
        }
    }
}
